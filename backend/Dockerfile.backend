# ----------------------------------------
# Base image
FROM python:3.11-slim

# ----------------------------------------
# Set working directory inside container
WORKDIR /app

# ----------------------------------------
# Install system-level dependencies (incl. MySQL client headers)
RUN apt-get update && apt-get install -y \
    build-essential \
    default-libmysqlclient-dev \
    libpq-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# ----------------------------------------
# Install Python dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# ----------------------------------------
# Copy all Django project files (this copies everything from backend/)
COPY . .

# ----------------------------------------
# Ensure wait-for-it.sh is executable
RUN chmod +x wait-for-it.sh
# ----------------------------------------

RUN chmod +x wait-for-it.sh

# ----------------------------------------
# Collect static files (optional if you use Django admin)
RUN python manage.py collectstatic --noinput || echo "Skipping collectstatic"

# ----------------------------------------
# Expose app port
EXPOSE 8000

# ----------------------------------------
# Wait for DB, then run gunicorn
CMD ["./wait-for-it.sh", "db:3306", "--", "gunicorn", "backend.wsgi:application", "--bind", "0.0.0.0:8000"]

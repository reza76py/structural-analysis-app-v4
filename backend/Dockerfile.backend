# ----------------------------------------
# Base image
FROM python:3.11-slim

# ----------------------------------------
# Set working directory inside container
WORKDIR /app

# ----------------------------------------
# Install system-level dependencies (incl. MySQL client headers)
RUN apt-get update && apt-get install -y \
    build-essential \
    default-libmysqlclient-dev \
    libpq-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# ----------------------------------------
# Install Python dependencies
CMD ["./wait-for-it.sh", "db:3306", "--", "gunicorn", "backend.wsgi:application", "--bind", "0.0.0.0:8000"]


# ----------------------------------------
# Copy all Django project files
COPY . .

# ✅ Copy and make wait-for-it.sh executable
COPY wait-for-it.sh ./wait-for-it.sh
RUN chmod +x ./wait-for-it.sh

# ----------------------------------------
# Collect static files (optional if you use Django admin)
RUN python manage.py collectstatic --noinput || echo "Skipping collectstatic"

# ----------------------------------------
# Expose app port
EXPOSE 8000
